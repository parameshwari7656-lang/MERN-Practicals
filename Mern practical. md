Develop a RESTful Student Management API using Node.js and Express.js. Create an Express server that performs CRUD operations on student records using appropriate HTTP methods.

terminal - npm init -y
           npm install express 

server.js 
const express = require("express");

const app = express();
const PORT = 3000;

app.use(express.json());

let students = [
    { id: 1, name: "ABC", age: 19 },
    { id: 2, name: "XYZ", age: 20 }
];

// CREATE - POST
app.post("/students", (req, res) => {
    students.push(req.body);
    res.send("Student added");
});

// READ - GET
app.get("/students", (req, res) => {
    res.json(students);
});

// UPDATE - PUT
app.put("/students/:id", (req, res) => {
    let id = Number(req.params.id);

    let student = students.find(s => s.id === id);

    if (student) {
        student.name = req.body.name;
        student.age = req.body.age;
        res.send("Student updated");
    } else {
        res.send("Student not found");
    }
});

// DELETE - DELETE
app.delete("/students/:id", (req, res) => {
    let id = Number(req.params.id);

    students = students.filter(s => s.id !== id);

    res.send("Student deleted");
});

app.listen(PORT, () => {
    console.log("Server running on port 3000");
});


